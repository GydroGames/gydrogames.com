---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, pubDate, category, author, image, imageAlt } = post.data;

const categoryColors: Record<string, string> = {
  'Dev Update':    '#8b5cf6',
  'Industry News': '#06b6d4',
  'Launch':        '#4ade80',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title={`${title} | GydroGames`}
  description={description}
  ogImage={image ?? '/images/og-image-default.png'}
  canonicalUrl={`https://gydrogames.com/news/${post.slug}`}
>
  <article class="article">
    <!-- Hero -->
    <header class="article-header">
      {image && (
        <div class="article-hero-image">
          <img src={image} alt={imageAlt ?? title} width="1200" height="675" loading="eager" />
        </div>
      )}
      <div class="container">
        <div class="article-meta">
          <a
            href="/news"
            class="back-link"
          >
            ← All News
          </a>
          <span
            class="category-badge"
            style={`background: ${categoryColors[category] ?? '#8b5cf6'}22; color: ${categoryColors[category] ?? '#8b5cf6'};`}
          >
            {category}
          </span>
        </div>
        <h1 class="article-title">{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-byline">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </div>
      </div>
    </header>

    <!-- Body -->
    <div class="container">
      <div class="article-body prose">
        <Content />
      </div>

      <footer class="article-footer">
        <a href="/news" class="btn btn-secondary">← Back to News</a>
        <a
          href="https://discord.gg/g7CPwwad"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-discord"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          Discuss on Discord
        </a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .article {
    padding-top: 70px; /* nav height */
  }

  .article-header {
    background: var(--color-surface);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .article-hero-image {
    width: 100%;
    aspect-ratio: 21/9;
    overflow: hidden;
    max-height: 420px;
    margin-bottom: var(--space-lg);
    background: var(--color-surface-hover);
  }

  .article-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back-link:hover {
    color: var(--color-accent-bright);
  }

  .category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .article-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: var(--space-sm);
  }

  .article-description {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
    max-width: 700px;
    line-height: 1.6;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* Prose / article body */
  .article-body {
    padding: var(--space-lg) 0;
    max-width: 740px;
  }

  .prose :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    margin: var(--space-lg) 0 var(--space-sm);
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: var(--space-md) 0 var(--space-xs);
    color: var(--color-text);
  }

  .prose :global(p) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--color-text-secondary);
    line-height: 1.8;
    padding-left: 1.5rem;
    margin-bottom: var(--space-md);
  }

  .prose :global(li) {
    margin-bottom: 0.35rem;
  }

  .prose :global(strong) {
    color: var(--color-text);
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--color-accent-bright);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast);
  }

  .prose :global(a:hover) {
    border-bottom-color: var(--color-accent-bright);
  }

  .prose :global(code) {
    background: var(--color-surface-hover);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    color: var(--color-accent-bright);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-md);
    margin: var(--space-md) 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .article-footer {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: var(--space-lg) 0 var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .article-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
