---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('news', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryColors: Record<string, string> = {
  'Dev Update':    '#8b5cf6',
  'Industry News': '#06b6d4',
  'Launch':        '#4ade80',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title="News | GydroGames"
  description="Dev updates, game launches, and industry news from the GydroGames studio."
  canonicalUrl="https://gydrogames.com/news"
>
  <section class="news-hero">
    <div class="container">
      <h1 class="hero-title">
        Studio <span class="gradient-text">News</span>
      </h1>
      <p class="hero-subtitle">
        Dev updates, game launches, and thoughts from the team.
      </p>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
  </section>

  <section class="news-section">
    <div class="container">
      {allPosts.length === 0 ? (
        <p class="empty">No posts yet. Check back soon.</p>
      ) : (
        <div class="news-grid">
          {allPosts.map(post => (
            <article class="news-card">
              {post.data.image && (
                <a href={`/news/${post.slug}`} class="card-image-link" tabindex="-1" aria-hidden="true">
                  <div class="card-image">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt ?? post.data.title}
                      width="600"
                      height="338"
                      loading="lazy"
                    />
                  </div>
                </a>
              )}
              <div class="card-content">
                <div class="card-meta">
                  <span
                    class="category-badge"
                    style={`background: ${categoryColors[post.data.category] ?? '#8b5cf6'}22; color: ${categoryColors[post.data.category] ?? '#8b5cf6'};`}
                  >
                    {post.data.category}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
                <h2 class="card-title">
                  <a href={`/news/${post.slug}`}>{post.data.title}</a>
                </h2>
                <p class="card-description">{post.data.description}</p>
                <a href={`/news/${post.slug}`} class="read-more">
                  Read more →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .news-hero {
    position: relative;
    padding: calc(var(--space-xl) + 70px) 0 var(--space-xl);
    text-align: center;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(139,92,246,0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-title {
    position: relative;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    margin-bottom: var(--space-sm);
    z-index: 1;
  }

  .hero-subtitle {
    position: relative;
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    z-index: 1;
  }

  .news-section {
    padding: var(--space-xl) 0;
    background: var(--color-surface);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .news-card {
    background: var(--color-bg);
    border: var(--card-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
  }

  .news-card:hover {
    transform: scale(1.02);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-border-hover);
  }

  .card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-surface-hover);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .news-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-content {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .category-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-meta time {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card-title a:hover {
    color: var(--color-accent-bright);
  }

  .card-description {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: auto;
    padding-bottom: var(--space-sm);
  }

  .read-more {
    color: var(--color-accent-bright);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .read-more:hover {
    color: var(--color-accent);
  }

  .empty {
    text-align: center;
    color: var(--color-text-secondary);
    padding: var(--space-xl) 0;
  }

  @media (max-width: 900px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 580px) {
    .news-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
